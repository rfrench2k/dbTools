<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <security>
            <requestFiltering>
                <!-- These run without a login: command-line / one-time setup only -->
                <hiddenSegments>
                    <add segment="scheduled-backup.php" />
                    <add segment="backup-schedule-config.php" />
                    <add segment="auto-register.php" />
                    <add segment="direct-register.php" />
                    <add segment="register-program.php" />
                    <add segment="config.php" />
                </hiddenSegments>
                <!-- Config (InterBase password), logs, dumps and docs -->
                <fileExtensions>
                    <add fileExtension=".json" allowed="false" />
                    <add fileExtension=".example" allowed="false" />
                    <add fileExtension=".log" allowed="false" />
                    <add fileExtension=".sql" allowed="false" />
                    <add fileExtension=".md" allowed="false" />
                    <add fileExtension=".ps1" allowed="false" />
                    <add fileExtension=".bat" allowed="false" />
                </fileExtensions>
            </requestFiltering>
        </security>
    </system.webServer>
</configuration>
