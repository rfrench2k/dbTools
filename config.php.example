<?php
/**
 * ============================================================================
 * DATABASE TOOLS - CONFIGURATION
 * ============================================================================
 *
 * Copy this file to config.php and update with your actual credentials.
 * MySQL 9.5 only (port 3307). The old 8.4 server (3306) is not used.
 */

// ============================================================================
// DATABASES TO BACKUP - EDIT THIS LIST!
// ============================================================================
$DATABASES_TO_BACKUP = [
    'APPINV', 'auth_db', 'BOBBLEHEADS', 'CARDS', 'Fantasy', 'health', 'INVEST', 'lahman', 'music', 'openai',
    // Only used by scheduled-backup.php, which SKServer does not schedule (Backup - Nightly handles backups)
];

// ============================================================================
// MYSQL VERSION CONFIGURATIONS
// ============================================================================
$MYSQL_VERSIONS = [
    '9.5' => [
        'label' => 'MySQL 9.5',
        'port' => 3307,
        'mysqldump' => 'C:\\Program Files\\MySQL\\MySQL Server 9.5\\bin\\mysqldump.exe',
        'mysql' => 'C:\\Program Files\\MySQL\\MySQL Server 9.5\\bin\\mysql.exe',
    ],
];

// ============================================================================
// ENVIRONMENT DEFINITIONS
// ============================================================================
$DB_ENVIRONMENTS = [
    // SKServer uses only MySQL 9.5 (port 3307).
    '95-local' => [
        'id' => '95-local',
        'label' => 'SKServer MySQL 9.5',
        'host' => 'localhost',
        'port' => 3307,
        'user' => 'your_username',
        'pass' => 'your_password',
        'version' => '9.5',
        'type' => 'prod',
    ],
];

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

/**
 * Get environment configuration by ID
 */
function getEnvironment($envId) {
    global $DB_ENVIRONMENTS;
    return $DB_ENVIRONMENTS[$envId] ?? null;
}

/**
 * Get all environments for a specific MySQL version
 */
function getEnvironmentsByVersion($version) {
    global $DB_ENVIRONMENTS;
    return array_filter($DB_ENVIRONMENTS, function($env) use ($version) {
        return $env['version'] === $version;
    });
}

/**
 * Get MySQL tools path for a version
 */
function getMySQLTools($version) {
    global $MYSQL_VERSIONS;
    return $MYSQL_VERSIONS[$version] ?? null;
}

/**
 * Get mysqldump path for an environment
 */
function getMysqldumpPath($envId) {
    $env = getEnvironment($envId);
    if (!$env) return null;
    $tools = getMySQLTools($env['version']);
    return $tools['mysqldump'] ?? null;
}

/**
 * Get mysql client path for an environment
 */
function getMysqlPath($envId) {
    $env = getEnvironment($envId);
    if (!$env) return null;
    $tools = getMySQLTools($env['version']);
    return $tools['mysql'] ?? null;
}

// ============================================================================
// LEGACY COMPATIBILITY (for existing code that uses old constants)
// ============================================================================
// host:port - PDO/mysqli accept it as is; shell commands use dbHostName()/dbHostPort()
define('DB_TEST_HOST', 'localhost:3307');
define('DB_TEST_USER', 'your_username');
define('DB_TEST_PASS', 'your_password');
define('DB_PROD_HOST', 'localhost:3307');
define('DB_PROD_USER', 'your_username');
define('DB_PROD_PASS', 'your_password');
define('MYSQLDUMP_PATH', 'C:\\Program Files\\MySQL\\MySQL Server 9.5\\bin\\mysqldump.exe');
define('MYSQL_PATH', 'C:\\Program Files\\MySQL\\MySQL Server 9.5\\bin\\mysql.exe');

// Split 'host:port' for mysqldump/mysql command lines (-h host -P port)
function dbHostName($hostPort) { return explode(':', $hostPort)[0]; }
function dbHostPort($hostPort) { $p = explode(':', $hostPort); return (int)($p[1] ?? 3307); }

// ============================================================================
// BACKUP DIRECTORY
// ============================================================================
// Change these paths to match your system
if (file_exists('W:\\')) {
    define('BACKUP_DIR', 'W:\\dbBackup\\');
} else {
    define('BACKUP_DIR', 'D:\\dumps\\');
}

// Ensure backup directory exists
if (!file_exists(BACKUP_DIR)) {
    @mkdir(BACKUP_DIR, 0755, true);
}

// ============================================================================
// ERROR REPORTING & EXECUTION TIME
// ============================================================================
error_reporting(E_ALL);
ini_set('display_errors', 1);
ini_set('log_errors', 1);
ini_set('max_execution_time', 300); // 5 minutes

// Used by backup-schedule-config.php (missing from the example)
define('APP_ENV', 'prod');

// Backup retention policy
define('BACKUP_RETENTION_DAYS', 30);
?>
